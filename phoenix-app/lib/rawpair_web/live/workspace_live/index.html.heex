<div class="p-8 space-y-6">
  <.header>
    Workspaces<:actions>
      <.link patch={~p"/workspaces/new"}>
        <.button>New project workspace</.button>
      </.link>
    </:actions>
  </.header>
  <p>Each workspace has persistent project files and an explicitly shared editor and terminal.</p>
  <div :for={row <- @rows} class="border rounded p-4 flex gap-4 items-center">
    <.link navigate={~p"/workspaces/#{row.workspace}"} class="font-bold">
      {row.workspace.name}
    </.link>
    <span>{row.workspace.backend} · {row.observed}</span>
    <.link navigate={~p"/rooms/#{row.workspace.slug}"}>Open editor and terminal</.link>
    <button phx-click="start" phx-value-id={row.workspace.id}>Start</button>
    <button
      phx-click="stop"
      phx-value-id={row.workspace.id}
      data-confirm="Stop all processes in this workspace? Project files will remain."
    >
      Stop
    </button>
  </div>
  <p :if={@rows == []}>
    No workspaces yet. Create a project or ask an owner to add your account.
  </p>

  <div :if={@live_action == :new} class="border rounded p-6 max-w-xl space-y-4">
    <h2 class="text-xl font-bold">Create a project workspace</h2>
    <p :if={@inventory_error} role="alert">Host inventory unavailable: {@inventory_error}</p>
    <.simple_form for={@form} id="new-workspace" phx-submit="create" phx-change="validate">
      <.input field={@form[:name]} label="Project name" />
      <.input field={@form[:description]} label="Description" />
      <.input
        field={@form[:backend]}
        type="select"
        label="Execution backend"
        options={
          Enum.map(Application.get_env(:rawpair, :backends, [:docker]), &{to_string(&1), &1})
        }
      />
      <%= if to_string(@form[:backend].value) == "host" do %>
        <.input
          field={@form[:host_slot]}
          type="select"
          label="Provisioned account and project directory"
          prompt="Choose an available slot"
          options={
            Enum.filter(@slots, &is_nil(&1["workspace_id"])) |> Enum.map(&{&1["label"], &1["id"]})
          }
        />
        <p>
          Slots keep existing project files when reused. The operator provisions native toolchains.
        </p>
      <% else %>
        <.input
          field={@form[:docker_image]}
          label="Docker image"
          placeholder="ghcr.io/rawpair/..."
        />
      <% end %>
      <.input
        field={@form[:cpu_limit]}
        label="CPU cores (blank uses backend default)"
        placeholder="2"
      />
      <.input
        field={@form[:mem_limit]}
        label="Memory (blank uses backend default)"
        placeholder="2g"
      />
      <.input field={@form[:tasks_limit]} type="number" label="Maximum tasks" />
      <:actions>
        <.button>Create workspace</.button>
        <.link patch={~p"/workspaces"}>Cancel</.link>
      </:actions>
    </.simple_form>
  </div>
</div>
