[Unit]
Description=RawPair native workspace management
After=network-online.target postgresql.service orqos-host.service
Wants=network-online.target

ConditionPathExists=/etc/rawpair/rawpair.env
ConditionPathExists=!/var/lib/rawpair/setup-required

[Service]
Type=simple
User=rawpair
Group=rawpair
WorkingDirectory=/opt/rawpair
EnvironmentFile=/etc/rawpair/rawpair.env
ExecStart=/opt/rawpair/bin/rawpair start
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/rawpair/tmp /var/lib/rawpair/runtime
StateDirectory=rawpair/runtime
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
