PHX_SERVER=true
PHX_HOST=rawpair.localhost
CHECK_ORIGIN=https://rawpair.localhost
DATABASE_URL=ecto://rawpair:REPLACE_DB_PASSWORD@127.0.0.1/rawpair
SECRET_KEY_BASE=REPLACE_WITH_64_RANDOM_BYTES_BASE64
RAWPAIR_BACKENDS=host
ORQOS_URL=http://127.0.0.1:9080
ORQOS_HOST_TOKEN=REPLACE_FROM_ETC_ORQOS_HOST_ENV
RAWPAIR_GATEWAY_TOKEN=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
RAWPAIR_COLLABORATION_TOKEN=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
RAWPAIR_PREVIEW_DOMAIN=apps.rawpair.localhost
RELEASE_TMP=/var/lib/rawpair/tmp
RELEASE_COOKIE=REPLACE_WITH_RANDOM_SECRET
